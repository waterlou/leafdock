{
    admin 0.0.0.0:2019 {
        origins localhost
    }
}

:{$HTTP_PORT:80} {
    # Management API
    handle /api/* {
        reverse_proxy localhost:3001
    }

    # Landing page — serve index.html for all unmatched paths
    handle {
        root * /data/landing
        rewrite * /index.html
        file_server
    }
}
