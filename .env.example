# HTTP port for Caddy reverse proxy
HTTP_PORT=80

# API key required for all management endpoints
MANAGEMENT_API_KEY=change-me-to-a-random-secret

# Port the management API listens on (inside Docker network)
PORT=3001

# Data directory for SQLite and app files
DATA_DIR=/data

# Caddy admin API address
CADDY_ADMIN_URL=http://localhost:2019

# Docker socket path (for docker-type apps)
DOCKER_SOCKET=/var/run/docker.sock

# Optional override for app-file storage. By default leafdock auto-detects
# what /data is mounted from (named volume or host bind) and mounts the same
# store into app containers — no configuration needed. Set only to force a
# specific volume name or host path, e.g. APP_VOLUME=/volume1/docker/leafdock/app_data
#APP_VOLUME=leafdock_app_data
