# HTTP port for Caddy reverse proxy
HTTP_PORT=80

# API key required for all management endpoints
MANAGEMENT_API_KEY=change-me-to-a-random-secret

# Port the management API listens on (inside Docker network)
PORT=3001

# Data directory for SQLite and app files
DATA_DIR=/data

# Caddy admin API address
CADDY_ADMIN_URL=http://localhost:2019

# Docker socket path (for docker-type apps)
DOCKER_SOCKET=/var/run/docker.sock

# Shared storage for app files: a Docker named volume (default), or an absolute
# host path (bind mount) when /data is bound to a host directory, e.g.
# APP_VOLUME=/volume1/docker/leafdock/app_data. Must match where /data lives.
APP_VOLUME=leafdock_app_data
