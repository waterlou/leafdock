# HTTP port for Caddy reverse proxy
HTTP_PORT=80

# API key required for all management endpoints
MANAGEMENT_API_KEY=change-me-to-a-random-secret

# Port the management API listens on (inside Docker network)
PORT=3001

# Data directory for SQLite and app files
DATA_DIR=/data

# Caddy admin API address
CADDY_ADMIN_URL=http://localhost:2019

# Docker socket path (for docker-type apps)
DOCKER_SOCKET=/var/run/docker.sock

# Optional override for app-file storage. By default leafdock auto-detects
# what /data is mounted from (named volume or host bind) and mounts the same
# store into app containers — no configuration needed. Set only to force a
# specific volume name or host path, e.g. APP_VOLUME=/volume1/docker/leafdock/app_data
#APP_VOLUME=leafdock_app_data

# Optional: tokens for cloning PRIVATE git repos (git deploy endpoints).
# The API never accepts or stores tokens — they are read from this environment
# at clone time. Host-keyed GIT_TOKENS wins over the single GIT_TOKEN:
#GIT_TOKENS='{"github.com":"<personal-access-token>"}'
#GIT_TOKEN=<personal-access-token>

# Compose host-safety opt-ins. Both are OFF by default: uploaded compose files
# may only bind-mount inside their own app directory and may not claim a fixed
# host port. Uncomment to widen the policy deliberately — an app that can reach
# a host path or a host port is an app that can reach the host.
#LEAFDOCK_ALLOWED_BIND_PATHS=/volume1/media,/volume2/backups
#LEAFDOCK_ALLOWED_HOST_PORTS=8080,9000-9010
